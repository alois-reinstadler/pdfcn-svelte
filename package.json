{
	"name": "pdfcn-svelte",
	"version": "0.1.0",
	"description": "Beautiful PDF components for Svelte, built on Forme and Takumi. shadcn-svelte conventions, copy, paste, and ship.",
	"homepage": "https://alois-reinstadler.github.io/pdfcn-svelte",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alois-reinstadler/pdfcn-svelte.git"
	},
	"bugs": {
		"url": "https://github.com/alois-reinstadler/pdfcn-svelte/issues"
	},
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.23.0",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./themes": {
			"types": "./dist/themes/index.d.ts",
			"svelte": "./dist/themes/index.js",
			"default": "./dist/themes/index.js"
		},
		"./bases/forme": {
			"types": "./dist/bases/forme/index.d.ts",
			"svelte": "./dist/bases/forme/index.js",
			"default": "./dist/bases/forme/index.js"
		},
		"./bases/takumi": {
			"types": "./dist/bases/takumi/index.d.ts",
			"svelte": "./dist/bases/takumi/index.js",
			"default": "./dist/bases/takumi/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run docs:build && pnpm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package -o dist",
		"prepublishOnly": "pnpm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:primitives": "node scripts/primitive-contract.mjs",
		"test:components": "node scripts/component-contract.mjs",
		"test:consumer": "node scripts/consumer-package-contract.mjs",
		"test:render": "node scripts/render-smoke.mjs",
		"test:documents": "node scripts/render-all-blocks.mjs",
		"docs:previews": "node scripts/render-all-blocks.mjs --write-previews",
		"docs:build": "pnpm run docs:previews && vite build",
		"docs:check": "node scripts/docs-contract.mjs",
		"registry:build": "node scripts/build-registry.mjs",
		"validate:api": "pnpm run package && node scripts/validate-package-exports.mjs && tsc --noEmit --strict --skipLibCheck --module esnext --moduleResolution bundler --target es2022 tests/public-api.ts",
		"validate:pack": "pnpm pack --dry-run",
		"validate": "pnpm run check && pnpm run test:primitives && pnpm run test:components && pnpm run test:render && pnpm run test:documents && pnpm run docs:build && pnpm run docs:check && pnpm run validate:api && pnpm run test:consumer && pnpm run validate:pack"
	},
	"peerDependencies": {
		"@formepdf/core": "^0.11.1",
		"@formepdf/svelte": "^0.11.1",
		"@takumi-rs/helpers": "^2.12.0",
		"svelte": "^5.30.0",
		"takumi-pdf": "^0.11.3"
	},
	"peerDependenciesMeta": {
		"@formepdf/core": {
			"optional": true
		},
		"@formepdf/svelte": {
			"optional": true
		},
		"@takumi-rs/helpers": {
			"optional": true
		},
		"takumi-pdf": {
			"optional": true
		}
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"qrcode": "^1.5.4",
		"tailwind-merge": "^3.3.1"
	},
	"devDependencies": {
		"@formepdf/core": "^0.11.1",
		"@formepdf/svelte": "^0.11.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/package": "^2.4.0",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@takumi-rs/helpers": "^2.12.0",
		"@types/node": "^22.15.3",
		"@types/qrcode": "^1.5.6",
		"pdfjs-dist": "^4.10.38",
		"svelte": "^5.38.0",
		"svelte-check": "^4.3.0",
		"takumi-pdf": "^0.11.3",
		"typescript": "^5.9.0",
		"vite": "^6.3.5"
	}
}
