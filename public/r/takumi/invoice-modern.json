{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "takumi/invoice-modern",
  "title": "Invoice Modern",
  "description": "Invoice Modern PDF document block for the takumi base.",
  "dependencies": [],
  "registryDependencies": [
    "./key-value.json",
    "./page-footer.json",
    "./page-header.json",
    "./section.json",
    "./table.json",
    "./text.json",
    "./utils.json"
