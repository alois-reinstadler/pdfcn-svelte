{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "takumi/invoice-creative",
  "title": "Invoice Creative",
  "description": "Invoice Creative PDF document block for the takumi base.",
  "dependencies": [],
  "registryDependencies": [
    "./key-value.json",
    "./page-footer.json",
    "./page-header.json",
    "./section.json",
    "./table.json",
